  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6"
